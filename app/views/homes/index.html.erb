<h2>Potepan Sharede<br>
まだ体験したことのない<br>
旅をしよう</h2>

<%= form_with url: search_rooms_path, method: :get, local: true do |f| %>
  <%= f.text_field :area, placeholder: "エリア名を入力" %>
  <%= f.submit "検索" %>
<% end %>

<h2>おすすめのエリア</h2>

<%= link_to rooms_path(keyword: "東京"), class: "area-card" do %>
  <%= image_tag "tokyo.jpg" %>
  <div class="area-label">
    <span class="area-name-ja">東京</span>
    <spam class="area-name-en">Tokyo</span>
  </div>
<% end %>

