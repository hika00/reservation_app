<h2>設定</h2>

<a href="/users/account">アカウント</a>
<a href="/users/profile">プロフィール</a> 

<h2>プロフィール</h2>

<%= form_with(model: @user, url: profile_users_path, local: true, method: :patch) do |f| %>
  <div class="field">
    <%= f.label :avatar, "アイコン画像" %>

    <% if @user.avatar.attached? %>
      <p><%= image_tag @user.avatar %></p>
    <% else %>
      <p><%= image_tag "avatar-default.png" %></p>
    <% end %>

    <%= f.file_field :avatar %>
  </div>

  <div class="field">
    <p><%= f.label :name, "名前" %></p>
    <p><%= f.text_field :name, autocomplete: "name" %></p>
  </div>

  <div class="field">
    <p><%= f.label :description, "自己紹介" %></p>
    <p><%= f.text_area :description, autocomplete: "description" %></p>
  </div>

  <%= link_to "キャンセル", profile_users_path %>

  <div class="actions">
    <%= f.submit "保存" %>
  </div>
<% end %>



