<h2>設定</h2>

<a href="/users/account">アカウント</a>
<a href="/users/profile">プロフィール</a> 

<h2>プロフィール</h2>

<%= form_with(model: resource, url: registration_path(resource_name), local: true, method: :put) do |f| %> 

  <div class="field">
    <%= f.label :avatar, "アイコン画像" %>

    <% if resource.avatar.attached? %>
      <%= image_tag resource.avatar %>
    <% else %>
      <%= image_tag "avatar-default.png" %>
    <% end %>

    <%= f.file_field :avatar %>
  </div>

  <div class="field">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :description, "自己紹介" %>
    <%= f.text_area :description %>
  </div>

  <%= link_to "キャンセル", users_profile_path %>

  <div class="actions">
    <%= f.submit "保存" %>
  </div>
<% end %>



