<h2>新規登録</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :ユーザー名 %></p>
    <p><%= f.text_field :name, autocomplete: "name" %></p>
  </div>

  <div class="field">
    <p><%= f.label :メールアドレス %></p>
    <p><%= f.email_field :email, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :パスワード %></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :確認用パスワード %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "新しいアカウントを作成" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
