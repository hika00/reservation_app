<header>
  <nav class="header-nav">
    <h1 class="header-logo">
      <%= link_to "Potepan Share", root_path %>
    </h1>
    
    <ul class="header-menu">
      <% if user_signed_in? %>
        <li>
          <details>
            <summary>
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, size: "40x40" %>
              <% else %>
                <%= image_tag "avatar-default.png", size: "40x40" %>
              <% end %>
              <%= current_user.name %>
            </summary>
            <ul>
              <li><%= link_to "施設の新規登録", new_room_path %></li>
              <li><%= link_to "予約済み一覧", reservations_path %></li>
              <li><%= link_to "登録済み一覧", rooms_path %></li>
              <li><%= link_to "アカウント設定", account_users_path %></li>
              <li><%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %></li>
            </ul>
          </details>
        </li>
      <% else %>
        <li class="header-auth-item"><%= link_to "ログイン", new_user_session_path, class: "header-auth-link" %></li>
        <li class="header-auth-item"><%= link_to "新規登録", new_user_registration_path, class: "header-auth-link header-auth-link--signup" %></li>
      <% end %>
    </ul>
  </nav>
</header>
