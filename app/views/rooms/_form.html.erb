<%= form_with model: @room, local: true do |f| %>
  <div class="field">
    <%= f.label :name, "施設名" %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :description, "施設詳細" %>
    <%= f.text_area :description %>
  </div>

  <div class="field">
    <%= f.label :price, "料金" %>
    <%= f.number_field :price %>
  </div>

  <div class="field">
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div class="field">
    <%= f.label :image, "施設画像" %>
    <%= f.file_field :image %>
  </div>

  <div class="actions">
    <%= f.submit "保存" %>
  </div>

  <div class="cancel-action">
    <%= link_to "キャンセル", request.referer || rooms_path %>
  </div>
<% end %>
