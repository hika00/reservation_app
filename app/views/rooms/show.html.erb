<%= render "rooms/search" %>

<%= link_to "←戻る", search_rooms_path(area: params[:area], keyword: params[:keyword]) %>

<% if @room.image.attached? %>
  <%= image_tag @room.image, size: "300x200" %>
<% else %>
  <%= image_tag "room-default.png", size: "300x200" %>
<% end %>

<%= @room.name %>

￥<%= @room.price %>~

<%= @room.address %>

<%= @room.description %>

<% if @reservation.errors.any? %>
  <div class="error-messages">
    <ul>
      <% @reservation.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [@room, @reservation], url: confirm_room_reservations_path(@room), local: true, data: { turbo: false } do |f| %>
  <div class="field">
    <p>
      <%= f.label :checkin_at, "チェックイン" %><br>
      <%= f.date_field :checkin_at %>
    </p>

    <p>
      <%= f.label :checkout_at, "チェックアウト" %><br>
      <%= f.date_field :checkout_at %>
    </p>

    <p>
      <%= f.label :guest_count, "人数" %><br>
      <%= f.number_field :guest_count %>
    </p>
  </div>

  <% if user_signed_in? %>
    <%= f.submit "予約する" %>
  <% else %>
    <%= f.submit "ログイン" %>
  <% end %>
<% end %>
