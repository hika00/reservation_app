<h2>登録済み一覧</h2>

<table>
  <thead>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>宿泊料金</th>
      <th>作成日</th>
    </tr>
  </thead>
  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td>
          <% if room.image.attached? %>
            <%= image_tag room.image, size: "100x70" %>
          <% else %>
            <%= image_tag "room-default.png", size: "100x70" %>
          <% end %>
        </td>

        <td>
          <%= link_to room.name, room_path(room) %>
        </td>

        <td>
          <%= room.description %>
        </td>

        <td>
          ￥<%= room.price %>~
        </td>

        <td>
          <%= room.created_at.strftime("%Y/%m/%d") %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
